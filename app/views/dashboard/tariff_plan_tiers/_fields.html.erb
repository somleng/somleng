<%= page_section(
  -> { tag.span(form.object.new_record? ? "New Tier" : "Edit Tier") },
  actions: tag.button(
    type: "button",
    class: "btn btn-outline-danger remove-button",
    data: {
      action: "click->remove-nested-form#remove",
    },
    title: "Delete"
  ) { tag.i(class: "fas fa-trash-alt") },
  id: nil,
  data: {
    controller: "tariff-plan-tier-form remove-nested-form",
    tariff_plan_tier_form_tariff_schedules_by_category_value: form.object.tariff_schedules_by_category.to_json,
    test_id: "tariff-plan-tier-form"
  }
) do %>
  <%= form.input(
    :_destroy,
    as: :hidden,
    input_html: {
      data: {
        remove_nested_form_target: "destroyElement"
      }
    }
  ) %>
  <%= form.input(:id, as: :hidden) %>

  <div class="row">
    <div class="col-md-6">
      <%= form.input(
        :tariff_schedule_id,
        collection: form.object.tariff_schedules_options_for_select,
        prompt: true,
        required: true,
        disabled: form.object.persisted?,
        input_html: {
          data: {
            controller: "enhanced-select",
            tariff_plan_tier_form_target: "tariffScheduleInput"
          }
        }
      ) %>
    </div>

    <div class="col-md-6">
      <%= form.input(
        :weight,
        as: :numeric,
        hint: "Used to set priority - higher values take precedence.",
        input_html: {
          min: 0
        }
      ) %>
    </div>
  </div>
<% end %>
