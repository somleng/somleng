<div class="card-body">
  <%= simple_form_for(resource, url: dashboard_tariff_package_wizard_path, wrapper: :input_group) do |f| %>
    <%= page_sections_container do %>
      <%= page_section("General") do %>
        <div class="row">
          <div class="col-sm-6">
            <%= f.input(:name, placeholder: "Standard") %>
          </div>

          <div class="col-sm-6">
            <%= f.input(:description, as: :text) %>
          </div>
        </div>
      <% end %>

      <%= page_section("Tariffs") do %>
        <% tariff_index = 0 %>

        <%= page_sections_container do %>
          <% group_collection_by(f.object.tariffs) { it.category.type }.each do |(category_type, tariffs)| %>
            <%= tag.div(class: "row") do %>
              <%= tag.div(class: "col-12") do %>
                <%= page_sections_container do %>
                  <%= page_section(category_type.humanize) do %>
                    <%= tag.div(class: "row") do %>
                      <% tariffs.each do |tariff| %>
                        <%= f.simple_fields_for(:tariffs, tariff, index: tariff_index) do |tariff_form| %>
                          <% tag.div(class: "col") do %>
                            <%= page_sections_container do %>
                              <%= page_section(
                                -> {
                                  safe_join(
                                    [
                                      if tariff.category.direction.inbound?
                                        tag.i(class: "fa-solid fa-arrow-left")
                                      elsif tariff.category.direction.outbound?
                                        tag.i(class: "fa-solid fa-arrow-right")
                                      end,
                                      tariff.category.direction.to_s.humanize
                                    ].compact
                                  )
                                },
                                actions: tariff_form.input(
                                  :enabled,
                                  as: :boolean,
                                  wrapper: :inline_boolean_switch,
                                  input_html: {
                                    data: {
                                      toggle_input_target: "enabledInput",
                                      action: "toggle-input#toggleEnabled"
                                    }
                                  }
                                ),
                                class: tariff.category.dasherize,
                                data: {
                                  controller: "toggle-input"
                                }
                              ) do %>
                                <%= tariff_form.input(
                                  :rate,
                                  label: "Rate (#{tariff_form.object.billing_currency.iso_code})",
                                  as: :numeric,
                                  required: true,
                                  append: tariff_form.object.rate_unit,
                                  hint: tariff_form.object.hint,
                                  input_html: {
                                    min: 0, step: 0.0001,
                                    data: {
                                      toggle_input_target: "input"
                                    }
                                  }
                                ) %>

                                <%= tariff_form.input(:category, as: :hidden) %>
                              <% end %>
                            <% end %>
                          <% end %>
                        <% end %>

                        <% tariff_index += 1 %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <div class="row">
        <div class="col-6">
          <%= f.button :submit %>
          <%= link_to_cancel %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
