<div class="card-body">
  <%= simple_form_for([:dashboard, resource], url: (dashboard_tariff_packages_path(filter_params) if @resource.new_record?), wrapper: :input_group, html: { data: { controller: "tariff-package-form" } }) do |f| %>
    <%= page_sections_container do %>
      <%= page_section("General") do %>
        <div class="row">
          <div class="col-sm-6">
            <%= f.input(:name) %>
          </div>

          <div class="col-sm-6">
            <%= f.input(:description, as: :text) %>
          </div>
        </div>
      <% end %>

      <%= page_section("Tariffs") do %>
        <%= render(
          "shared/tariff_plan_assignment_form",
          form: f,
          collection: f.object.plans,
          collection_method: :plans
        ) %>
      <% end %>

      <div class="row">
        <div class="col-6">
          <%= f.button :submit %>
          <%= link_to_cancel %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
