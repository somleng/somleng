<%= page_title(title: "Edit Account Settings") %>

<div class="card-body">
  <%= simple_form_for(@resource, url: dashboard_account_settings_path, wrapper: :input_group) do |f| %>
    <%= page_sections_container do %>
      <%= page_section("General") do %>
        <div class="row">
          <div class="col-sm-6">
            <%= f.input(:name, maxlength: 128, hint: "A friendly name for your account") %>
          </div>
        </div>
      <% end %>

      <%= page_section("Text to Speech") do %>
        <%= render("default_tts_configuration_fields", f: f) %>
      <% end %>

      <div class="row">
        <div class="col-6">
          <%= f.button :submit %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
