<%= button_to(
  path,
  class: "btn btn-outline-danger",
  form_class: "d-inline",
  title: local_assigns.fetch(:title, "Delete"),
  data: { bs_toggle: :tooltip },
  method: :delete,
  form: {
    data: {
      turbo_confirm: "This action cannot be undone. Are you sure you want to continue?"
    }
  }
) do %>
  <i class="fas fa-trash-alt"></i> <%= local_assigns[:text] %>
<% end %>
